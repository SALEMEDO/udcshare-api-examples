# Configuration du système de backup UDCShare

# Clé API UDCShare (obtenue depuis votre dashboard)
UDCSHARE_API_KEY=votre_clé_api_udcshare

# URL de l'API (ne changez que si nécessaire)
UDCSHARE_API_URL=https://udcshare.com/api/v1

# Répertoires à backup (séparez par des virgules)
BACKUP_DIR_1=/path/to/documents
BACKUP_DIR_2=/path/to/invoices
BACKUP_DIR_3=/path/to/contracts

# Schedule du backup (format HH:MM)
BACKUP_SCHEDULE=02:00

# Activer/désactiver le backup automatique
BACKUP_ENABLED=true

# Configuration retry
MAX_RETRIES=3
RETRY_DELAY=5
RETRY_BACKOFF=2

# Configuration fichiers
MAX_FILE_SIZE=25  # en GB
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,png,pdf,zip

# Configuration base de données
DB_PATH=backup_system.db

# Monitoring
MONITORING_ENABLED=true
ALERT_EMAIL=
ALERT_THRESHOLD=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=backup_system.log
